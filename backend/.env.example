# =============================================================
# KEDAI KOPI ASMDS – Backend Environment Variables
# Salin file ini ke .env dan isi nilainya sebelum menjalankan.
# JANGAN commit file .env ke git!
# =============================================================

# ── DATABASE ─────────────────────────────────────────────────
# Opsi 1 (Utama – PostgreSQL lokal di VPS Ubuntu):
DATABASE_URL="postgresql://kopiuser:GANTI_PASSWORD@localhost:5432/kedaikopi_db"

# Opsi 2 (Alternatif – Neon Serverless PostgreSQL, untuk dev lokal):
# DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ── JWT ──────────────────────────────────────────────────────
# Generate string acak panjang:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="ganti-dengan-string-rahasia-yang-sangat-panjang-min-32-karakter"
JWT_EXPIRES_IN="7d"

# ── SERVER ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── CORS ─────────────────────────────────────────────────────
# Domain produksi (ganti sesuai domain kamu)
ALLOWED_ORIGIN="https://kedai-kopi-asmds.store"
