# =============================================================
# Template environment untuk docker compose (Kedai Kopi ASMDS)
# Salin ke `.env` di folder yang sama, lalu isi nilai ASLI.
# JANGAN commit file `.env` (sudah di .gitignore).
# =============================================================

# ── PostgreSQL (service `db`) ────────────────────────────────
POSTGRES_USER=kopiuser
# Samakan dgn password di DATABASE_URL pada .env lama (/var/www/<APP_DIR>/backend/.env)
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_ASLI
# Nama DB ASLI. Task menyebut "kedaikopi"; .env.example lama "kedaikopi_db".
# Pakai yang benar-benar ada di server (cek: sudo -u postgres psql -l).
POSTGRES_DB=kedaikopi

# ── App (service `app`) ──────────────────────────────────────
# WAJIB sama PERSIS dgn JWT_SECRET di .env lama agar token/sesi login lama tetap valid.
JWT_SECRET=GANTI_DENGAN_JWT_SECRET_ASLI
JWT_EXPIRES_IN=7d
ALLOWED_ORIGIN=https://kedai-kopi-asmds.store

# ── Inisialisasi skema/seed ──────────────────────────────────
# Biarkan false saat migrasi (data datang dari restore SQL dump).
# Set true HANYA untuk database kosong/fresh.
RUN_DB_PUSH=false
RUN_SEED=false
